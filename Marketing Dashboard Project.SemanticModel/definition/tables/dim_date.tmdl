	column 'Week Start' =
			
			'dim_date'[full_date]
			    - WEEKDAY('dim_date'[full_date], 2) + 1
		formatString: General Date
		lineageTag: ccac9e25-872b-4610-a709-e143ded6aea0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month Start' =
			
			DATE(
			    YEAR('dim_date'[full_date]),
			    MONTH('dim_date'[full_date]),
			    1
			)
		formatString: General Date
		lineageTag: b827df1b-4079-4ecd-a5c1-34642f7d4dda
