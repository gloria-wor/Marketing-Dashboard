	measure 'Card Footer Spend' = ```
			
			VAR CurrentSpend = [Total Spend]
			VAR PriorSpend   = [Spend PY]
			VAR _perc = DIVIDE ( CurrentSpend - PriorSpend, PriorSpend )
			
			VAR _FormattedPY = 
			    SWITCH(
			        TRUE(),
			        PriorSpend >= 1000000000, "Ksh " & FORMAT(PriorSpend / 1000000000, "#,##0.00,,,") & "bn",
			        PriorSpend >= 1000000, "Ksh " & FORMAT(PriorSpend / 1000000, "#,##0.00,,") & "M",
			        "Ksh " & FORMAT(PriorSpend, "#,##0.00")
			    )
			
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", 
			        _perc < 0, "#EF4444", 
			        "#6B7280"             
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// FIXED SVG: Removed bold, size 12, and adjusted x coordinates so they don't overlap
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' fill='" & _Color & "'>" & 
			        _Arrow & " " & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · vs " & _FormattedPY & " PY" & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 14c6ffd2-be16-4b44-b9e9-18cc6d1220f0
		dataCategory: ImageUrl

