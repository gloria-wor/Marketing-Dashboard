	measure 'vs Last Month' =
			
			VAR CurrentSpend = [Total Spend]
			VAR PriorSpend =
			    CALCULATE(
			        [Total Spend],
			        REMOVEFILTERS('gold dim_date'),
			        TREATAS(
			            SELECTCOLUMNS(
			                VALUES('gold dim_date'[full_date]),
			                "full_date", EDATE('gold dim_date'[full_date], -1)
			            ),
			            'gold dim_date'[full_date]
			        )
			    )
			VAR _perc = DIVIDE(CurrentSpend - PriorSpend, PriorSpend)
			RETURN
			    SWITCH(
			        TRUE(),
			        _perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
			        _perc < 0, UNICHAR(11167) & " " & FORMAT(_perc * -1, "0.0%"),
			        FORMAT(_perc, "0.0%")
			    )
		displayFolder: Monthly Comparisons
		lineageTag: 30d4e77e-9fb7-43fd-b92c-d914a93c63d4

	measure 'vs Last Year' = ```
			
			VAR CurrentSpend = [Total Spend]
			VAR PriorSpend   = [Spend PY]
			VAR _perc = DIVIDE ( CurrentSpend - PriorSpend, PriorSpend )
			VAR _percformat = 
			SWITCH(
			    TRUE(),
			    _perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
			    _perc < 0, UNICHAR(11167) & " " & FORMAT(_perc*-1, "0.0%"),
			    FORMAT(_perc, "0.0%")
			)
			RETURN
			_percformat
			```
		displayFolder: Monthly Comparisons
		lineageTag: d725d5be-73c2-4b9f-ba7a-03a156f0a73f

	measure 'Card FooterImpressions' = ```
			
			// 1. Calculate YoY for Impressions
			VAR CurrentImpressions = [Total Impressions]
			VAR PriorImpressions   = [Impressions PY]
			VAR _perc = DIVIDE(CurrentImpressions - PriorImpressions, PriorImpressions)
			
			// 2. Get your CPM measure
			VAR _CPM = [CPM]
			
			// 3. Determine color and arrow
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey for 0
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG (Centered properly)
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " " & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · " & _CPM & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: e95ba88b-61c7-41a6-b882-38e5bf68fdbe
		dataCategory: ImageUrl

	measure 'Card Footer Clicks' = ```
			
			VAR CurrentClicks = [Total Clicks] // Replace with your actual Clicks column
			VAR PriorClicks   = [Clicks PY]    // Replace with your actual Prior Year Clicks measure
			VAR _perc = DIVIDE(CurrentClicks - PriorClicks, PriorClicks)
			
			VAR _CTR = DIVIDE([Total Clicks], [Total Impressions], 0) // Replace with your actual CTR formula
			VAR _FormattedCTR = FORMAT(_CTR, "0.00%")
			
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// The SVG Footer
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · CTR " & _FormattedCTR & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: b37a64a4-4f89-4e77-8fae-fd2dd965b8c2
		dataCategory: ImageUrl

	measure 'Card Footer Conversions' = ```
			
			// 1. Calculate YoY for Conversions
			VAR CurrentConv = [Total Conversions]
			VAR PriorConv   = [Conversions PY]
			VAR _perc = DIVIDE(CurrentConv - PriorConv, PriorConv)
			
			// 2. Get your CVR measure and format it
			VAR _CVR = [CVR]
			VAR _FormattedCVR = FORMAT(_CVR, "0.00%")
			
			// 3. Determine color and arrow based on positive/negative
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG Footer
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · CVR " & _FormattedCVR & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 9334bb67-aee1-437d-803c-ebdb1a3588af
		dataCategory: ImageUrl

	measure 'Card Footer ROAS' = ```
			
			// 1. Calculate YoY for ROAS
			VAR CurrentROAS = [ROAS]
			VAR PriorROAS   = [ROAS PY] 
			VAR _perc = DIVIDE(CurrentROAS - PriorROAS, PriorROAS)
			
			// 2. Get Revenue formatted in Millions/Billions
			VAR _Rev = [Total Revenue]
			VAR _FormattedRev = 
			    SWITCH(
			        TRUE(),
			        _Rev >= 1000000000, "Ksh " & FORMAT(_Rev / 1000000000, "#,##0.00,,,bn") & " revenue",
			        _Rev >= 1000000, "Ksh " & FORMAT(_Rev / 1000000, "#,##0.00,,.M") & " revenue",
			        "Ksh " & FORMAT(_Rev, "#,##0.00") & " revenue"
			    )
			
			// 3. Determine color and arrow
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey for 0
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG (Centered properly)
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · " & _FormattedRev & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 287239e9-1d13-4936-a1f4-3105a17a6a4f
		dataCategory: ImageUrl

