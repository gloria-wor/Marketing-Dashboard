	measure 'Chip Region2' = ```
			
			VAR _Text = SELECTEDVALUE('gold dim_geo'[region], "All") 
			VAR _Color = "#4A4458"
			VAR _BgColor = "#FFFFFF"
			VAR _IconColor = "#7C3AED"
			
			VAR _SVG = 
			"<svg xmlns='http://www.w3.org/2000/svg' width='200' height='40' viewBox='0 0 200 40'>
			    <rect width='190' height='34' x='5' y='3' rx='17' fill='" & _BgColor & "' stroke='#E5E7EB' />
			    
			    <!-- The <g> tag groups the icon and scales it by 1.4x. 
			         translate(24, 7) moves the scaled icon into the right position -->
			    <g transform='translate(24, 7) scale(1.4)'>
			        <path d='M5 3a4 4 0 0 0-4 4c0 3 4 7 4 7s4-4 4-7a4 4 0 0 0-4-4z' fill='" & _IconColor & "'/>
			        <circle cx='5' cy='7' r='1.5' fill='white'/>
			    </g>
			    
			    <!-- Shifted text slightly to the right to accommodate the bigger icon -->
			    <text x='52' y='24' font-family='Segoe UI, sans-serif' font-size='14' font-weight='600' fill='" & _Color & "'>" & _Text & "</text>
			</svg>"
