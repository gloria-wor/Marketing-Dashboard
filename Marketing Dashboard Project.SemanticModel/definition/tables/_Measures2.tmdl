	measure 'Rolling 12M Spend Chart' =
			
			VAR CurrentDate = EOMONTH(MAX('gold dim_date'[full_date]), 0) // Finds the END of the month
			VAR StartDate = EDATE(CurrentDate, -11)
			VAR StartMonth = DATE(YEAR(StartDate), MONTH(StartDate), 1)
			
			RETURN
			CALCULATE(
			    [Total Spend],
			    'gold dim_date'[full_date] >= StartMonth && 'gold dim_date'[full_date] <= CurrentDate
			)
		displayFolder: Filters
		lineageTag: 6da1f3c4-59ce-4af9-a7f6-2a307629ec8f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Rolling 12M Revenue Chart' =
			
			VAR CurrentDate = EOMONTH(MAX('gold dim_date'[full_date]), 0) // Finds the END of the month
			VAR StartDate = EDATE(CurrentDate, -11)
			VAR StartMonth = DATE(YEAR(StartDate), MONTH(StartDate), 1)
			
			RETURN
			CALCULATE(
			    [Total Revenue],
			    'gold dim_date'[full_date] >= StartMonth && 'gold dim_date'[full_date] <= CurrentDate
