	measure 'Card Footer CPA' = ```
			
			// 1. Calculate YoY for CPA (Avg Cost / Acquisition)
			VAR CurrentCPA = [Avg Cost]
			VAR PriorCPA   = [Avg Cost PY]
			VAR _perc = DIVIDE(CurrentCPA - PriorCPA, PriorCPA)
			
			// 2. Get your CPC measure formatted
			VAR _CPC = [CPC]
			VAR _FormattedCPC = "CPC Ksh " & FORMAT(_CPC, "#,##0.00")
			
			// 3. Determine color and arrow
			// Note: For costs, a negative % is GOOD (Green), a positive % is BAD (Red)
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc < 0, "#10B981", // Green (Cost went down)
			        _perc > 0, "#EF4444", // Red (Cost went up)
			        "#6B7280"             // Grey for 0
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG (Centered properly)
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='16' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " " & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='16' fill='#6B7280'>" & 
			        " · " & _FormattedCPC & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 7525b31c-160e-45d7-ad3d-28e0b8c77c11

	measure 'Selected Period Value' =
			
			VAR SelectedID = SELECTEDVALUE('PeriodTable'[PeriodID], 4) // Default to YTD
			VAR CurrentDate = MAX('gold dim_date'[full_date])
			VAR StartOfWeek = CurrentDate - WEEKDAY(CurrentDate, 2) + 1 // Monday as start of week
			RETURN
			SWITCH(
			    SelectedID,
			    1, CALCULATE([Total Spend], DATESBETWEEN('gold dim_date'[full_date], StartOfWeek, CurrentDate)),
			    2, CALCULATE([Total Spend], DATESMTD('gold dim_date'[full_date])),
			    3, CALCULATE([Total Spend], DATESQTD('gold dim_date'[full_date])),
			    4, CALCULATE([Total Spend], DATESYTD('gold dim_date'[full_date]))
			)
		displayFolder: Filters
		lineageTag: 745e59d0-4152-447e-9e10-e38e56b8501d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Dynamic Title' = ```
			
			VAR SelectedPeriod = SELECTEDVALUE('PeriodTable'[ PeriodName], "YTD")
			VAR SelectedYear = SELECTEDVALUE('gold dim_date'[Year], "All Years")
			VAR SelectedMonth = SELECTEDVALUE('gold dim_date'[month_name], "")
			
			// If a specific month is selected, show it (e.g., "Aug 2025"). Otherwise, just show the year.
			VAR DateText = 
			    IF(
			        ISBLANK(SelectedMonth) || SelectedMonth = "All", 
			        SelectedYear, 
			        SelectedMonth & " " & SelectedYear
			    )
			
			RETURN 
			    "Executive Summary — " & SelectedPeriod & " " & DateText
			```
		displayFolder: Filters
		lineageTag: 042e86ab-c902-4282-b299-71d2d8c8818a

