	measure 'Platform Pacing Bar' = ```
			
			VAR _Spent = [Spent Filtered]
			VAR _Budget = [Budget Filtered]
			VAR _Perc = DIVIDE(_Spent, _Budget, 0)
			VAR _PercText = FORMAT(_Perc, "0%")
			
			// Shorter number format to save space
			VAR _SpentFormatted = FORMAT(_Spent / 1000000000, "Ksh 0.0B")
			VAR _BudgetFormatted = FORMAT(_Budget / 1000000000, "Ksh 0.0B")
			
			// Width of the progress bar fill (max 250)
			VAR _FillWidth = IF(_Perc > 1, 250, _Perc * 250) 
			VAR _Color = IF(_Perc > 1, "#EF4444", "#10B981") // Red if >100%, Green if under
			
			// The SVG (Platform name removed, bar shifted to start at x='0')
			VAR _SVG = 
			"<svg xmlns='http://www.w3.org/2000/svg' width='500' height='40' viewBox='0 0 500 40'>
			    
			    <!-- Background track -->
			    <rect x='0' y='15' width='250' height='8' rx='4' fill='#F3F4F6' />
			    
			    <!-- Filled track -->
			    <rect x='0' y='15' width='" & _FillWidth & "' height='8' rx='4' fill='" & _Color & "' />
			    
			    <!-- Spent / Budget Text -->
			    <text x='260' y='23' font-family='Segoe UI, sans-serif' font-size='12' fill='#6B7280'>" & _SpentFormatted & " / " & _BudgetFormatted & "</text>
			    
			    <!-- Percentage Text -->
			    <text x='480' y='23' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='13' font-weight='bold' fill='#111827'>" & _PercText & "</text>
			</svg>"
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Budget
		lineageTag: f46b7c6e-9a31-42d9-8d46-87cd3b0431fb
		dataCategory: ImageUrl

	measure 'Pacing Header Combined' = ```
			
			VAR _Pacing = [Pacing %]
			VAR _PercText = FORMAT(_Pacing, "0%")
			VAR _StatusText = 
			    SWITCH(
			        TRUE(),
			        _Pacing > 1.0, "Over Budget",
			        _Pacing >= 0.95 && _Pacing <= 1.0, "On Pace",
			        "Under Budget"
			    )
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _Pacing > 1.0, "#EF4444", // Red
			        _Pacing >= 0.95 && _Pacing <= 1.0, "#10B981", // Green
			        "#6B7280" // Grey
			    )
			
			VAR _SVG = 
			"<svg xmlns='http://www.w3.org/2000/svg' width='150' height='70' viewBox='0 0 150 70'>
			    <!-- The Big Number -->
			    <text x='75' y='35' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='28' font-weight='bold' fill='" & _Color & "'>" & _PercText & "</text>
			    <!-- The Small Status Text -->
			    <text x='75' y='55' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='12' font-weight='600' fill='" & _Color & "'>" & _StatusText & "</text>
			</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Budget
		lineageTag: 95f33d03-1b7e-4850-a3ed-6716351c3d69
		dataCategory: ImageUrl

	measure 'Top 5 Campaign Spend' = ```
			
			VAR CampaignSpend = [Total Spend] // Use your main Spend measure
			VAR CampaignRank = 
			    RANKX(
			        ALL('gold dim_campaign'[campaign_name]), // Use your exact campaign name column
			        [Total Spend],
			        ,
			        DESC,
			        Dense
			    )
			RETURN
			    IF(
			        CampaignRank <= 5,
			        CampaignSpend,
			        BLANK() // Hides anything ranked 6 or higher
			    )
