table _Measures
	lineageTag: f81a5887-0499-405c-9e9c-fc295f66824c

	measure 'Budget Utilization %' =
			
			DIVIDE('fact_ad_performance_daily'[Total Spend],
			    'fact_campaign_budget_daily'[Total Campaign Budget],BLANK()
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Campaign measures
		lineageTag: 11f1c0ab-f20d-49e5-a30e-2430ff5d540f

	measure 'C budget PY' =
			
			VAR LastDataDate =
			    CALCULATE (
			        MAX ( 'dim_date'[full_date] ),
			        'fact_ad_performance_daily'
			    )
			VAR CurrentDates =
			    FILTER (
			        VALUES ( 'dim_date'[full_date] ),
			        'dim_date'[full_date] <= LastDataDate
			    )
			VAR PriorYearDates =
			    SELECTCOLUMNS (
			        CurrentDates,
			        "full_date", EDATE ( 'dim_date'[full_date], -12 )
			    )
			RETURN
			    CALCULATE (
			        'fact_campaign_budget_daily'[Total Campaign Budget],
			        REMOVEFILTERS ( 'dim_date' ),
			        TREATAS ( PriorYearDates, 'dim_date'[full_date] )
			    )
		displayFolder: Campaign measures
		lineageTag: e80452ac-0ee7-41b7-8508-5e6ea57aab9c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Campaign spend PY' =
			
			VAR LastDataDate =
			    CALCULATE (
			        MAX ( 'dim_date'[full_date] ),
			        'fact_ad_performance_daily'
			    )
			VAR CurrentDates =
			    FILTER (
			        VALUES ( 'dim_date'[full_date] ),
			        'dim_date'[full_date] <= LastDataDate
			    )
			VAR PriorYearDates =
			    SELECTCOLUMNS (
			        CurrentDates,
			        "full_date", EDATE ( 'dim_date'[full_date], -12 )
			    )
			RETURN
			    CALCULATE (
			        'fact_campaign_budget_daily'[Total Campaign Spend],
			        REMOVEFILTERS ( 'dim_date' ),
			        TREATAS ( PriorYearDates, 'dim_date'[full_date] )
			    )
		displayFolder: Campaign measures
		lineageTag: d3e5434f-9a2c-4075-abff-65c2aade38bc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CBudget CF' =
			
			VAR _currentcbudg = [Total Campaign Budget]
			VAR _priorcbudg = [C budget PY]
			VAR _change = DIVIDE(_currentcbudg - _priorcbudg,_priorcbudg)
			RETURN
			SWITCH(TRUE(), _change>0, "green",_change<0, "red", "grey")
		displayFolder: Campaign measures
		lineageTag: d012d4d6-6a76-4888-85aa-204e14797060

	measure 'CBudget YoY %' =
			
			VAR Currentcbudg = [Total Campaign Budget]
			VAR Priorcbudg   = [C budget PY]
			VAR _perc = DIVIDE ( Currentcbudg - Priorcbudg, Priorcbudg )
			VAR _percformat = FORMAT(_perc, "+0.0%;-0.0%;0.0%")
			RETURN
			IF(_perc > 0,UNICHAR(129157) & " " & _percformat,UNICHAR(129158) & " " & _percformat)
		displayFolder: Campaign measures
		lineageTag: 3b48a3b8-6065-40c0-8b4a-3a2e50f75412

