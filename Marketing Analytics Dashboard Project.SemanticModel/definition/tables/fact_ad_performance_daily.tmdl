table fact_ad_performance_daily
	lineageTag: 2f7ea668-2484-4792-9948-d81f78baa0b7

	measure ROAS = DIVIDE([Total Revenue],[Total Spend],0)
		displayFolder: Main measures
		lineageTag: 91857585-775a-43e7-9deb-e01d3a5bf7d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ROI = DIVIDE([Total Revenue]-[Total Spend],[Total Spend],0)
		displayFolder: Main measures
		lineageTag: df7cfff3-24dd-4d6d-abff-738b1b7bae6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spend PY' =
			
			// Latest date that actually has fact rows in the current selection
			VAR LastDataDate =
			    CALCULATE (
			        MAX ( 'dim_date'[full_date] ),
			        'fact_ad_performance_daily'
			    )
			// The dates currently selected (by Year / Month / Date range slicers),
			// cut off at the last date with data so a partial year is compared
			// like-for-like instead of against a full prior year
			VAR CurrentDates =
			    FILTER (
			        VALUES ( 'dim_date'[full_date] ),
			        'dim_date'[full_date] <= LastDataDate
			    )
			// The same dates, each moved back exactly 12 months
			VAR PriorYearDates =
			    SELECTCOLUMNS (
			        CurrentDates,
			        "full_date", EDATE ( 'dim_date'[full_date], -12 )
			    )
			RETURN
			    CALCULATE (
			        [Total Spend],
			        // drop the Year/Month/Date-range filters on dim_date...
			        REMOVEFILTERS ( 'dim_date' ),
			        // ...and filter to the shifted dates instead
			        TREATAS ( PriorYearDates, 'dim_date'[full_date] )
			    )
		displayFolder: Main measures
		lineageTag: f963a76e-10f8-4612-8cc1-c28ce1efe233

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure CTR = DIVIDE('fact_ad_performance_daily'[Total clicks],'fact_ad_performance_daily'[Total Impressions])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Main measures
		lineageTag: 46a08846-1399-4883-b139-c7481db3a28a

	measure CPA = DIVIDE('fact_ad_performance_daily'[Total Spend],'fact_ad_performance_daily'[Total Conversions])
		formatString: "Ksh"#,0.00;-"Ksh"#,0.00;"Ksh"#,0.00
		displayFolder: Main measures
		lineageTag: cdddbf3f-2774-4a2f-a2c5-fafba4a9ba8b

		annotation PBI_FormatHint = {"currencyCulture":"ebu-KE"}

