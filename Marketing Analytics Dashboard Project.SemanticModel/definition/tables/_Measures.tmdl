	/// Platform ROAS relative to the blended ROAS. Positive = better than average.
	measure 'ROAS vs Blended %' = DIVIDE([ROAS], [Blended ROAS Line]) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Platform Analysis
		lineageTag: 745e7459-b2f5-42ad-95a3-77ca4e1878ae

	/// Platform CPA relative to blended CPA. Negative = cheaper than average (good).
	measure 'CPA vs Blended %' = DIVIDE([CPA], [Blended CPA]) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Platform Analysis
		lineageTag: 43508ed4-187c-4285-9e59-18b0f1a5153f

	measure 'Engagement Rate' = DIVIDE([Total Engagements], [Total Impressions])
		formatString: 0.00%
		displayFolder: Platform Analysis
		lineageTag: ef5e3dad-2578-45fd-b18b-7f82e082236a

	measure 'Platform ROAS Rank' = IF(ISINSCOPE(dim_platform[platform_name]), RANKX(ALLSELECTED(dim_platform[platform_name]), [ROAS], , DESC, Dense))
		formatString: 0
		displayFolder: Platform Analysis
		lineageTag: 94925980-ec94-408c-a766-66692542edeb

	/// Like-for-like budget utilisation: spend and budget both from fact_campaign_budget_daily. Use instead of 'Budget Utilization %', which divides ad-fact spend by budget-table budget and over-states utilisation.
	measure 'Budget Used %' = DIVIDE([Total Campaign Spend], [Total Campaign Budget])
		formatString: 0.0%
		displayFolder: Budget
		lineageTag: a23fe4e5-ad75-44c6-9f65-55944c002ccb

	/// Campaign-table spend minus budget (KES). Positive = overspent.
	measure 'Budget Variance' = [Total Campaign Spend] - [Total Campaign Budget]
		formatString: #,0;-#,0;0
		displayFolder: Budget
		lineageTag: cbba6025-b56b-478e-901e-1efe09c5d63a

	/// Revenue share minus spend share, in percentage points. Positive = platform returns more revenue than the share of budget it consumes.
	measure 'Share Gap (pp)' = ([Revenue Share %] - [Spend Share %]) * 100
		formatString: +0.0" pp";-0.0" pp";0.0" pp"
		displayFolder: Platform Analysis
		lineageTag: 48cb0627-5971-4cfa-be32-a945ab5ff3ed

	/// Scale: ROAS 10%+ above blended. Review: 10%+ below. Hold: in between.
	measure 'Platform Verdict' =
			
			IF(
			    ISINSCOPE(dim_platform[platform_name]) && NOT ISBLANK([ROAS]),
			    SWITCH(
			        TRUE(),
			        [ROAS vs Blended %] >= 0.10, "▲ SCALE",
			        [ROAS vs Blended %] <= -0.10, "▼ REVIEW",
			        "● HOLD"
			    ),
			    BLANK()
			)
		displayFolder: Platform Analysis
		lineageTag: b0cad3de-7591-4eff-bc68-c5e36d12de3c

	/// Subtitle sentence naming the best ROAS and lowest CPA platform in scope.
	measure 'Platform Insight' =
			VAR t = ADDCOLUMNS(ALLSELECTED(dim_platform[platform_name]), "@r", [ROAS], "@c", [CPA])
			VAR best = TOPN(1, t, [@r], DESC)
			VAR cheap = TOPN(1, t, [@c], ASC)
			RETURN
			"Best ROAS: " & MAXX(best, dim_platform[platform_name]) & " (" & FORMAT(MAXX(best, [@r]), "0.00") & "x)  |  Lowest CPA: " & MAXX(cheap, dim_platform[platform_name]) & " (KES " & FORMAT(MINX(cheap, [@c]), "#,0") & ")"
		displayFolder: Platform Analysis
		lineageTag: 4c9bf19a-3802-4f4e-8b98-abb642bc4286

	/// Median campaign ROAS on the campaign's own platform (campaigns in scope). Median rather than blended ROAS so a few outlier campaigns don't pull the benchmark up. Falls back to the overall median when no single platform is in context.
	measure 'Peer ROAS' =
			VAR p = SELECTEDVALUE(fact_ad_performance_daily[platform_key])
			RETURN
			IF(ISBLANK(p),
			    CALCULATE(MEDIANX(FILTER(VALUES(dim_campaign[campaign_key]), NOT ISBLANK([ROAS])), [ROAS]), ALLSELECTED(dim_campaign)),
			    CALCULATE(MEDIANX(FILTER(VALUES(dim_campaign[campaign_key]), NOT ISBLANK([ROAS])), [ROAS]), ALLSELECTED(dim_campaign), fact_ad_performance_daily[platform_key] = p))
		formatString: 0.00"x"
		displayFolder: Campaign Analysis
		lineageTag: fddda93e-f29f-4db6-b69f-5755ca1876a4

	measure 'Campaigns Running' = DISTINCTCOUNT(fact_ad_performance_daily[campaign_key])
		formatString: #,0
		displayFolder: Campaign Analysis
		lineageTag: 9e894d42-f95b-471b-9df0-af32e3ffb267

	measure 'Campaign Spend Share %' = DIVIDE([Total Spend], CALCULATE([Total Spend], ALLSELECTED(dim_campaign)))
