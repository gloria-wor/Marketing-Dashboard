	measure 'Dynamic Current Formatted' =
			
			VAR MetricName = SELECTEDVALUE('Metrics Table'[Metric])
			VAR Val = [Dynamic Current]
			VAR _Abs = ABS(Val)
			// One compact scale for every count / amount: bn, M, K. Unit letters kept OUTSIDE FORMAT().
			VAR _Compact =
			    IF(_Abs >= 1000000000, FORMAT(Val / 1000000000, "#,##0.00") & "bn",
			    IF(_Abs >= 1000000, FORMAT(Val / 1000000, "#,##0.00") & "M",
			    IF(_Abs >= 1000, FORMAT(Val / 1000, "#,##0.00") & "K",
			    FORMAT(Val, "#,##0.00"))))
			RETURN
			SWITCH(
			    MetricName,
			    "ROAS", FORMAT(Val, "0.00") & "x",
			    "CTR", FORMAT(Val, "0.00%"),
			    _Compact
			)
		displayFolder: Matrix Visuals
		lineageTag: d4481005-cc79-4a44-bec9-b19443c176b7

