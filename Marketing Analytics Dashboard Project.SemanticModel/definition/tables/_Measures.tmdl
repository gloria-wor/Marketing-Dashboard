		lineageTag: 4cbf5eb0-ebd0-440e-bf18-8da7fc813e31

	/// Scale: ROAS >=15% above platform peers. Review: >10% below. Maintain: in between.
	measure 'Campaign Tier' =
			VAR i = [ROAS Index vs Peers]
			RETURN IF(ISBLANK([ROAS]), BLANK(), SWITCH(TRUE(), i >= 1.15, "Scale", i < 0.9, "Review", "Maintain"))
		displayFolder: Campaign Analysis
		lineageTag: 4aa63e44-dccf-4d05-a043-0b4b41cb6cc8

