	measure 'Status Badge' =
			
			// Status follows performance vs prior year, drawn as a rounded-rectangle pill with the text inside.
			// Two states only: Healthy (green) and Watch (red).
			// CPA is a cost metric, so an INCREASE is unfavourable.
			VAR _Metric = SELECTEDVALUE('Metrics Table'[Metric])
			VAR _Cur = [Dynamic Current]
			VAR _Pri = [Dynamic Prior]
			VAR _Chg = DIVIDE(_Cur - _Pri, _Pri)
			VAR _Adj = IF(_Metric = "CPA", -_Chg, _Chg) // positive = favourable
			VAR _Text = IF(_Adj >= 0, "Healthy", "Watch")
			// # is encoded as %23 so the colours survive inside the data URI
			VAR _TextColor = IF(_Text = "Healthy", "%23065F46", "%23FF0000")
			VAR _BgColor   = IF(_Text = "Healthy", "%23D1FAE5", "%23FEE2E2")
			VAR _SVG =
			"<svg xmlns='http://www.w3.org/2000/svg' width='80' height='24' viewBox='0 0 80 24'>
			    <rect x='2' y='2' width='76' height='20' rx='10' ry='10' fill='" & _BgColor & "'/>
			    <text x='40' y='16' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='11' font-weight='600' fill='" & _TextColor & "'>" & _Text & "</text>
			</svg>"
			RETURN IF(ISBLANK(_Chg), BLANK(), "data:image/svg+xml;utf8," & _SVG)
		displayFolder: Matrix Visuals
		lineageTag: cdf13bbf-7702-46b2-9e76-b47b31a13670
		dataCategory: ImageUrl

	measure 'Dynamic Change Color' =
			
			// Font colour for the change column. Green = favourable, red (FF0000) = unfavourable.
			// CPA is inverted (an increase is bad).
			VAR _Metric = SELECTEDVALUE('Metrics Table'[Metric])
			VAR _Chg = DIVIDE([Dynamic Current] - [Dynamic Prior], [Dynamic Prior])
			VAR _Adj = IF(_Metric = "CPA", -_Chg, _Chg)
			RETURN
			    SWITCH(TRUE(), ISBLANK(_Chg), "#6B7280", _Adj > 0, "#10B981", _Adj < 0, "#FF0000", "#6B7280")
		displayFolder: Matrix Visuals
		lineageTag: 77455946-483b-47bc-8615-41336f8bc3e7

	measure 'Dynamic Change Bar' =
			
			// Diverging data bar for the change vs prior year. Bar points right for an increase, left for a decrease.
			// Colour = favourable (green) / unfavourable (red); Cost / Acquisition is inverted (an increase is bad).
			// Length uses square-root scaling against the largest change across all metrics so small changes stay visible.
			VAR _Metric = SELECTEDVALUE('Metrics Table'[Metric])
			VAR _Chg = DIVIDE([Dynamic Current] - [Dynamic Prior], [Dynamic Prior])
			VAR _MaxAbs =
			    MAXX(
			        ALL('Metrics Table'[Metric]),
			        ABS(DIVIDE([Dynamic Current] - [Dynamic Prior], [Dynamic Prior]))
			    )
			VAR _Adj = IF(_Metric = "Cost / Acquisition", -_Chg, _Chg)
			VAR _Color = IF(_Adj >= 0, "#10B981", "#EF4444")
			VAR _W = MAX(2, SQRT(DIVIDE(ABS(_Chg), _MaxAbs, 0)) * 76)
			VAR _X = IF(_Chg >= 0, 80, 80 - _W)
			VAR _SVG =
			"<svg xmlns='http://www.w3.org/2000/svg' width='160' height='24' viewBox='0 0 160 24'>
			    <rect x='" & _X & "' y='6' width='" & _W & "' height='12' rx='2' fill='" & _Color & "' />
			    <line x1='80' y1='2' x2='80' y2='22' stroke='#9CA3AF' stroke-width='1' />
			</svg>"
			RETURN IF(ISBLANK(_Chg), BLANK(), "data:image/svg+xml;utf8," & _SVG)
		displayFolder: Matrix Visuals
		lineageTag: 0e872187-f0b0-4d0a-b715-42a5e7beb8d5
		dataCategory: ImageUrl

