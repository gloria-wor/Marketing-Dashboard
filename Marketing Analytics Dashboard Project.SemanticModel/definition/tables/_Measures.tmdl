	measure 'vs Last Month' =
			
			VAR CurrentSpend = [Total Spend]
			VAR PriorSpend =
			    CALCULATE(
			        [Total Spend],
			        REMOVEFILTERS('dim_date'),
			        TREATAS(
			            SELECTCOLUMNS(
			                VALUES('dim_date'[full_date]),
			                "full_date", EDATE('dim_date'[full_date], -1)
			            ),
			            'dim_date'[full_date]
			        )
			    )
			VAR _perc = DIVIDE(CurrentSpend - PriorSpend, PriorSpend)
			RETURN
			    SWITCH(
			        TRUE(),
			        _perc > 0, UNICHAR(11165) & " " & FORMAT(_perc, "0.0%"),
			        _perc < 0, UNICHAR(11167) & " " & FORMAT(_perc * -1, "0.0%"),
			        FORMAT(_perc, "0.0%")
			    )
		displayFolder: Monthly Comparisons
		lineageTag: 30d4e77e-9fb7-43fd-b92c-d914a93c63d4

	measure 'vs Last Year' = ```
			
