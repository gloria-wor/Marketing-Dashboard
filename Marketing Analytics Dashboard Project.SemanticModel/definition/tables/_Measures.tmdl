	measure 'Card Footer Clicks' = ```
			
			VAR CurrentClicks = [Total Clicks] // Replace with your actual Clicks column
			VAR PriorClicks   = [Clicks PY]    // Replace with your actual Prior Year Clicks measure
			VAR _perc = DIVIDE(CurrentClicks - PriorClicks, PriorClicks)
			
			VAR _CTR = DIVIDE([Total Clicks], [Total Impressions], 0) // Replace with your actual CTR formula
			VAR _FormattedCTR = FORMAT(_CTR, "0.00%")
			
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// The SVG Footer
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='20' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='20' fill='#6B7280'>" & 
			        " · CTR " & _FormattedCTR & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: b37a64a4-4f89-4e77-8fae-fd2dd965b8c2
		dataCategory: ImageUrl

	measure 'Card Footer Conversions' = ```
			
			// 1. Calculate YoY for Conversions
			VAR CurrentConv = [Total Conversions]
			VAR PriorConv   = [Conversions PY]
			VAR _perc = DIVIDE(CurrentConv - PriorConv, PriorConv)
			
			// 2. Get your CVR measure and format it
			VAR _CVR = [CVR]
			VAR _FormattedCVR = FORMAT(_CVR, "0.00%")
			
			// 3. Determine color and arrow based on positive/negative
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG Footer
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='20' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='20' fill='#6B7280'>" & 
			        " · CVR " & _FormattedCVR & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 9334bb67-aee1-437d-803c-ebdb1a3588af
		dataCategory: ImageUrl

	measure 'Card Footer CPA' = ```
			
			// 1. Calculate YoY for CPA (Avg Cost / Acquisition)
			VAR CurrentCPA = [CPA]
			VAR PriorCPA   = [CPA PY]
			VAR _perc = DIVIDE(CurrentCPA - PriorCPA, PriorCPA)
			
			// 2. Get your CPC measure formatted (no currency prefix - currency is stated in the visual title)
			VAR _CPC = [CPC]
			VAR _FormattedCPC = "CPC " & FORMAT(_CPC, "#,##0.00")
			
			// 3. Determine color and arrow
			// Note: For costs, a negative % is GOOD (Green), a positive % is BAD (Red)
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc < 0, "#10B981", // Green (Cost went down)
			        _perc > 0, "#EF4444", // Red (Cost went up)
			        "#6B7280"             // Grey for 0
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG (Centered properly)
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='20' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " " & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='20' fill='#6B7280'>" & 
			        " · " & _FormattedCPC & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Monthly Comparisons
		lineageTag: 7525b31c-160e-45d7-ad3d-28e0b8c77c11

	measure 'Card Footer ROAS' = ```
			
			// 1. Calculate YoY for ROAS
			VAR CurrentROAS = [ROAS]
			VAR PriorROAS   = [ROAS PY] 
			VAR _perc = DIVIDE(CurrentROAS - PriorROAS, PriorROAS)
			
			// 2. Get Revenue formatted in Millions/Billions (no currency prefix - currency is stated in the visual title)
			VAR _Rev = [Total Revenue]
			VAR _FormattedRev = 
			    SWITCH(
			        TRUE(),
			        _Rev >= 1000000000, FORMAT(_Rev / 1000000000, "#,##0.00,,,bn") & " revenue",
			        _Rev >= 1000000, FORMAT(_Rev / 1000000, "#,##0.00,,.M") & " revenue",
			        FORMAT(_Rev, "#,##0.00") & " revenue"
			    )
			
			// 3. Determine color and arrow
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "#10B981", // Green
			        _perc < 0, "#EF4444", // Red
			        "#6B7280"             // Grey for 0
			    )
			VAR _Arrow = 
			    SWITCH(
			        TRUE(),
			        _perc > 0, "▲",
			        _perc < 0, "▼",
			        ""
			    )
			VAR _PercText = FORMAT(ABS(_perc), "0.0%")
			
			// 4. Build the SVG (Centered properly)
			VAR _SVG = 
			    "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			    "<text x='40%' y='15' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='20' font-weight='600' fill='" & _Color & "'>" & 
			        _Arrow & " +" & _PercText & 
			    "</text>" &
			    "<text x='42%' y='15' text-anchor='start' font-family='Segoe UI, sans-serif' font-size='20' fill='#6B7280'>" & 
			        " · " & _FormattedRev & 
			    "</text>" &
			    "</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
