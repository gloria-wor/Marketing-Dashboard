	measure 'Budget Pacing Status' =
			VAR u = [Budget Used %]
			RETURN IF(ISBLANK(u), BLANK(), SWITCH(TRUE(), u > 1.1, "Over budget", u < 0.7, "Under-delivering", "On track"))
		displayFolder: Budget
