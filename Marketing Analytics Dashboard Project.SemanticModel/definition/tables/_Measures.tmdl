	measure 'Underperforming Label' =
			
			VAR s = [Underperforming Spend]
			VAR spendText =
			    SWITCH (
			        TRUE (),
			        s >= 1000000, FORMAT ( s / 1000000, "##0.0" ) & "M",
			        s >= 1000, FORMAT ( s / 1000, "##0.0" ) & "K",
