	measure 'Budget Filtered' =
			
			SUMX(
			    FILTER(
			        'fact_campaign_budget_daily',
			        RELATED('dim_platform'[platform_name]) IN {"Google Ads", "Meta Ads", "TikTok Ads"}
			    ),
			    'fact_campaign_budget_daily'[daily_budget_kes]
			)
		formatString: #,0.00;-#,0.00;#,0.00
		displayFolder: Budget
		lineageTag: 8c0e2a81-bdab-4609-986f-fa7cf7c2754b

		annotation PBI_FormatHint = {"currencyCulture":"ebu-KE"}

	measure 'Pacing %' = DIVIDE([Spent Filtered], [Budget Filtered], 0)
		displayFolder: Budget
		lineageTag: 74559514-4fd7-4e36-a75f-268c4f9bc5fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pacing Header Combined' = ```
			
			VAR _Pacing = [Pacing %]
			VAR _PercText = FORMAT(_Pacing, "0%")
			VAR _StatusText = 
			    SWITCH(
			        TRUE(),
			        _Pacing > 1.0, "Over Budget",
			        _Pacing >= 0.95 && _Pacing <= 1.0, "On Pace",
			        "Under Budget"
			    )
			VAR _Color = 
			    SWITCH(
			        TRUE(),
			        _Pacing > 1.0, "#EF4444", // Red
			        _Pacing >= 0.95 && _Pacing <= 1.0, "#10B981", // Green
			        "#6B7280" // Grey
			    )
			
			VAR _SVG = 
			"<svg xmlns='http://www.w3.org/2000/svg' width='150' height='70' viewBox='0 0 150 70'>
			    <!-- The Big Number -->
			    <text x='75' y='35' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='36' font-weight='bold' fill='" & _Color & "'>" & _PercText & "</text>
			    <!-- The Small Status Text -->
			    <text x='75' y='55' text-anchor='middle' font-family='Segoe UI, sans-serif' font-size='24' font-weight='600' fill='" & _Color & "'>" & _StatusText & "</text>
			</svg>"
			
			RETURN "data:image/svg+xml;utf8," & _SVG
			```
		displayFolder: Budget
		lineageTag: 95f33d03-1b7e-4850-a3ed-6716351c3d69
		dataCategory: ImageUrl

	measure 'Platform Pacing Bar' =
			
			VAR _Spent = [Spent Filtered]
			VAR _Budget = [Budget Filtered]
			VAR _Perc = DIVIDE(_Spent, _Budget, 0)
			VAR _PercText = FORMAT(_Perc, "0%")
			
			VAR _SpentFormatted = IF(_Spent >= 1000000000, FORMAT(_Spent / 1000000000, "0.00") & "bn", FORMAT(_Spent / 1000000, "#,##0") & "M")
			VAR _BudgetFormatted = IF(_Budget >= 1000000000, FORMAT(_Budget / 1000000000, "0.00") & "bn", FORMAT(_Budget / 1000000, "#,##0") & "M")
			
			// The track now represents 0% to MaxPerc. Raise this if a platform can exceed 160%.
			VAR _MaxPerc = 1.6
			VAR _TrackWidth = 250
			VAR _Scale = _TrackWidth / _MaxPerc
			
			// Where the 100% budget line sits on the track
			VAR _MarkerX = 1 * _Scale
			
			// Fill is proportional, capped only at the end of the track
			VAR _FillWidth = MIN(_Perc, _MaxPerc) * _Scale
			VAR _OverWidth = MAX(_FillWidth - _MarkerX, 0)
			
			VAR _Color = IF(_Perc > 1, "#FF0000", "#34A853")
			VAR _OverColor = "#991B1B"
			VAR _TextColor = IF(_Perc > 1, "#DC2626", "#15803D")
			
			VAR _SVG =
			"<svg xmlns='http://www.w3.org/2000/svg' width='500' height='48' viewBox='0 0 500 48'>
			    <rect x='0' y='19' width='" & _TrackWidth & "' height='12' rx='6' fill='#F3F4F6' />
			    <rect x='0' y='19' width='" & _FillWidth & "' height='12' rx='6' fill='" & _Color & "' />
			    <rect x='" & _MarkerX & "' y='19' width='" & _OverWidth & "' height='12' rx='0' fill='" & _OverColor & "' />
			    <line x1='" & _MarkerX & "' y1='14' x2='" & _MarkerX & "' y2='36' stroke='#374151' stroke-width='2' />
			    <text x='260' y='34' font-family='Segoe UI, sans-serif' font-size='17' font-weight='600' fill='" & _TextColor & "'>" & _SpentFormatted & " / " & _BudgetFormatted & "</text>
			    <text x='480' y='34' text-anchor='end' font-family='Segoe UI, sans-serif' font-size='15' font-weight='bold' fill='" & _TextColor & "'>" & _PercText & "</text>
			</svg>"
			RETURN "data:image/svg+xml;utf8," & _SVG
