	measure 'Selected Period Value' =
			
			VAR SelectedID = SELECTEDVALUE('PeriodTable'[PeriodID], 4) // Default to YTD
			VAR CurrentDate = MAX('dim_date'[full_date])
			VAR StartOfWeek = CurrentDate - WEEKDAY(CurrentDate, 2) + 1 // Monday as start of week
			RETURN
			SWITCH(
			    SelectedID,
			    1, CALCULATE([Total Spend], DATESBETWEEN('dim_date'[full_date], StartOfWeek, CurrentDate)),
			    2, CALCULATE([Total Spend], DATESMTD('dim_date'[full_date])),
			    3, CALCULATE([Total Spend], DATESQTD('dim_date'[full_date])),
			    4, CALCULATE([Total Spend], DATESYTD('dim_date'[full_date]))
			)
		displayFolder: Filters
		lineageTag: 745e59d0-4152-447e-9e10-e38e56b8501d

