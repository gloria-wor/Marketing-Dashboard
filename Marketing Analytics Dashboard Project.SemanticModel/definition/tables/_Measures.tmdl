			    SELECTEDVALUE('Metrics Table'[Metric]),
			    "Ad Spend", [Total Spend],
			    "Impressions", [Total Impressions],
			    "CTR", [CTR],
			    "Conversions", [Total Conversions],
			    "ROAS", [ROAS],
